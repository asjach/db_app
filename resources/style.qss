/* REFERENSI: https://github.com/ColinDuquesnoy/QDarkStyleSheet/blob/master/qdarkstyle/dark/darkstyle.qss */

#prev_order_by, 
#prev_kolom {
    image: url(:/icon/resources/icon/less_than.svg);
    width: 15px;
    height: 15px;
    padding: 5px;
    border-radius: 1px;
}

#prev_order_by:hover, 
#prev_kolom:hover  {
    image: url(:/icon/resources/icon/less_than_hover.svg);
	background-color: #1EFFFFFF;
}
 
#prev_order_by:pressed, 
#prev_kolom:pressed{
   background-color: #28FFFFFF;
}

#next_order_by, 
#next_kolom {
   	image: url(:/icon/resources/icon/more_than.svg);
       width: 15px;
       height: 15px;
       padding: 5px;
       border-radius: 1px;
}

#next_order_by:hover, 
#next_kolom:hover {
    image: url(:/icon/resources/icon/more_than_hover.svg);
	background-color: #1EFFFFFF;
}

#next_order_by:pressed {
   background-color: #28FFFFFF;
}


#frame_filter{
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    background-color: var(--background_color);
}

QMenuBar {
	background-color: var(--background_color);
	color:rgba(255, 255, 255, 0.8);
    padding: 4px;

}


/* TAB WIDGET */
QTabWidget::pane {
		background-color: var(--background_color);
        padding: 0px;
        border-radius: 0px;
}

QTabWidget>QWidget{
    border-top: 1px solid var(--border);
}

QListWidget::item{
    padding: 0px 3px;
    text-align:center;
}

QTabBar::tab {
	padding:3px 20px 3px 20px;
    margin: 0px 0px 0px 0px;
	color:rgb(250,250,250);
  	background-color: #181818;
	border-radius: 0px;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
}

QTabBar::tab:hover{
    color: rgba(255, 255, 255, 0.8);
}

QTabBar::tab:selected {
    color: rgba(255, 255, 255, 0.8);
    background-color: #1F1F1F;
    border-top: 2px solid var(--highlight);
}
 QTabBar::tab:last{
    border-right: 1px solid rgba(255, 255, 255, 0.1);
 }

QTabBar::tab:!selected {
    background-color: #181818;
    color: rgba(255, 255, 255, 0.6);
}
QTabBar::tab:!selected:hover {
    background-color: #1F1F1F;
    color: rgba(255, 255, 255, 0.8);
}


/*TOMBOL X pada Tab*/
QTabBar::close-button{
    padding: 2px;
    border:1px solid transparent;
}

QTabBar::close-button:selected{
    image:url(:/dark/resources/icon/dark/multiply_white.svg);
}

QTabBar::close-button:hover{
    image:url(:/dark/resources/icon/dark/multiply_red.svg);
}



/* COMBO BOX */
QComboBox{
    
    border: 1px solid var(--border);
    selection-background-color: var(--selection_background);
    padding-left: 5px;
    background-color: var(--background2);
}

QComboBox:hover{
    border: 1px solid var(--grey2);
}
QComboBox:selected{
    border: 1px solid green;
}
/* QComboBox QAbstractItemView{
    padding-top: 5px;
    border: 1px solid var(--grey1);
    padding-left:5px;
} */
QComboBox QAbstractItemView::item {
    color: var(--putih1);
    selection-background-color: rgba(29, 176, 151, 0.5);
    min-height: 1.5em;  
}
/* QComboBox QAbstractItemView::item:hover {
    color: white;
} */


QComboBox::drop-down{
    border: 0px solid green;
    width: 20px;
    margin: 0px 0px;
}

QComboBox::down-arrow {
    image:url(:/dark/resources/icon/dark/expand_arrow.svg);
    height: 14px;
    width: 14px;
    margin-right: 5px;
    padding: 0px;
}
QComboBox::down-arrow:hover{
    image:url(:/dark/resources/icon/dark/expand_arrow_hover.svg);
}

/* QLINEEDIT */
QLineEdit{
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding-left: 4px;
    background-color: var(--background2);
}

QLineEdit:hover{
    border: 1px solid rgba(255, 255, 255, 0.3);
}

QLineEdit:active{
    background-color: var(--background2);
}
QLineEdit:focus{
    background-color: var(--header);
    color: white;
}



/* QHeaderView */
QHeaderView {
  background-color: var(--header);
  min-height: 2em;
  border-radius: 0;
  font-weight: normal;
  font-family: 'Aptos Narrow';
  font-size: 11pt;
  padding: 0px 0px;
}
QHeaderView::vertical{
    border:none;
}
QHeaderView::section {
  background-color: var(--header);
  color: #f1f1f1;
  border-radius: 0;
}

QHeaderView::section::horizontal {
  padding-top: 0px 10px;
}

QHeaderView::section::vertical:item {
    padding: 0px 5px;
    font-weight: normal;
}

QHeaderView::section:vertical{
    color: gray;
}



/* QTABLEVIEW */

QTableView {
  background-color: var(--background2);
  padding: 0px;
  gridline-color: var(--border);
  border-radius: 0px;
}

QTableView:selected {
  background-color: transparent;
  color: #455364;
}

QTableView::item:pressed {
  background-color: var(--hijau);
}


QTableView::item:selected:active {
  background-color: #0b443b;
}

QTableView::item:selected:!active{
  color: #DFE1E2;
  background-color: var(--selection_background);
}

QTableView::item:!selected:hover {
  outline: 0;
  color: #DFE1E2;
  background-color: var(--selection_background);
}

QTableCornerButton::section {
  background-color: var(--header);
  border-bottom: 0px solid var(--border);
  border-top: 0px solid var(--border);
  border-left: 0px solid var(--border);
}


QListView{
    background-color: var(--background2);
    border: 1px solid rgba(255, 255, 255, 0.1);
}

QListView::item:selected{
    background-color: var(--selection_background);
}
QListView::item:selected:active{
    border:none;
    background-color: var(--selection_background);
}
QListView::item:selected:!active{
    background-color: var(--selection_background);
    border:none;
}


